# Dependency directories (never commit these)
node_modules/
jspm_packages/
web_modules/

# Environment variables and secrets (CRITICAL for security)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Local MongoDB data (if running MongoDB locally instead of Atlas)
data/
db/
*.db

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDEs, editors, and OS-specific files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Build, coverage, and testing outputs (if using TypeScript or Jest)
dist/
build/
coverage/
.nyc_output/

# Optional: Serverless or cloud deployment folders
.serverless/
.terraform/
